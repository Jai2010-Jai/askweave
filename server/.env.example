# Copy to .env and fill in. Never commit .env. Anything left out uses the default in weave/config.py.

# ----- AI -----
# One AI for chat, apps and websites, no fallback: groq | gemini | glm
WEAVE_AI_PROVIDER=groq
GROQ_API_KEY=                      # https://console.groq.com (free: 1,000 requests/day, 8,000 tokens/min per model)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey (WEAVE_AI_PROVIDER=gemini)
GEMINI_MODEL=auto
GLM_API_KEY=                       # https://z.ai (WEAVE_AI_PROVIDER=glm; glm-4.7-flash is free but often busy)
GLM_MODEL=glm-4.7-flash
# Or GLM through OpenRouter (paid per use, not rate-limited like the free key):
# GLM_BASE_URL=https://openrouter.ai/api/v1
# GLM_MODEL=z-ai/glm-5.3-flash
WEAVE_CHAT_BRAIN=on                # plain-language conversation (off = commands and rules only)
WEAVE_CHAT_TIMEOUT_SECONDS=60
WEAVE_NLG=off                      # AI rewording of fixed replies
WEAVE_VOICE=on                     # voice notes, transcribed on this machine with faster-whisper
WEAVE_VOICE_MODEL=base

# ----- Server -----
WEAVE_HOST=127.0.0.1
WEAVE_PORT=8765
PUBLIC_BASE_URL=https://app.askweave.xyz   # scripts/run_prod.sh sets this too

# ----- WhatsApp / SMS through Twilio -----
WEAVE_SMS_PROVIDER=twilio
WEAVE_WHATSAPP_PROVIDER=twilio     # twilio | meta | off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=               # E.164, e.g. +12345550100
TWILIO_WHATSAPP_NUMBER=
TWILIO_CHANNEL=whatsapp
# Only with WEAVE_WHATSAPP_PROVIDER=meta (WhatsApp Cloud API directly):
# META_ACCESS_TOKEN=  META_PHONE_NUMBER_ID=  META_BUSINESS_ACCOUNT_ID=  META_APP_SECRET=  META_VERIFY_TOKEN=

# ----- Accounts (Google sign-in only) -----
# Redirect URI in Google Cloud: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# closed (owners only) | link (owners + LINK <code>) | open (anyone) | account (sign up at /start, then LINK <code>)
WEAVE_SMS_SIGNUP=account
WEAVE_SMS_OWNER_NUMBERS=           # comma-separated E.164 numbers that skip sign-up
WEAVE_SMS_DEFAULT_COUNTRY_CODE=+1
WEAVE_SMS_DAILY_BUILDS=20
WEAVE_SMS_GUEST_DAILY_BUILDS=3

# ----- Android builds (paths are found automatically when empty) -----
JAVA_HOME=
ANDROID_HOME=

# ----- Websites -----
WEAVE_WEBSITE_BUILDER=on
WEAVE_WEBSITE_ENGINE_DIR=../website-engine     # relative to server/
WEAVE_WEBSITE_PAGES=3
WEAVE_WEBSITE_DEPLOY=weave                     # weave: live at <username>.<WEAVE_SITES_DOMAIN> | netlify | off
WEAVE_SITES_DOMAIN=askweave.xyz

# ---- Visitor analytics for hosted sites (no cookies, no third party, no IP or user agent stored) ----
WEAVE_ANALYTICS=on                             # count visits to <username>.<WEAVE_SITES_DOMAIN> sites
WEAVE_ANALYTICS_RAW_DAYS=35                    # how long single visits are kept before only daily totals remain
WEAVE_ANALYTICS_ROLLUP_DAYS=400                # how long the daily totals are kept
# On behind a reverse proxy or the Cloudflare tunnel, so a visitor's address is read from CF-Connecting-IP
# or X-Forwarded-For. Left off behind a proxy, every visitor looks alike and each day counts 1 visitor.
WEAVE_TRUST_PROXY=on

# ---- Keeping the data alive (see docs/DEPLOYMENT.md) ----
# Everything lives in one SQLite file under WEAVE_DATA_DIR. On a container platform without a mounted
# volume that disk is wiped on every redeploy, so point this at real storage.
# WEAVE_DATA_DIR=/data
# Copy each nightly backup off this machine; {path} is the backup file.
# WEAVE_BACKUP_UPLOAD=rclone copy {path} b2:weave-backups
# WEAVE_BACKUP_KEEP=7
# Refuse to start if the database is missing, rather than quietly creating an empty one.
# WEAVE_REQUIRE_EXISTING_DATA=on
# Set once on a genuine first deployment to a container disk.
# WEAVE_INIT_DATA=on
